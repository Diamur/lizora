# Пример конфигурации .env.local
# Скопируй этот файл в .env.local и заполни значения

BASE_URL=http://localhost:3000
DATA_DIR=./data

# Пароль администратора (bcrypt hash)
# Для генерации: node scripts/hash-password.js yourpassword
ADMIN_PASSWORD_HASH=

# Секрет для iron-session (минимум 32 символа, случайная строка)
SESSION_SECRET=change-this-to-a-random-secret-string-at-least-32-chars

# Максимальный размер загружаемого видео (байты)
# 2 ГБ = 2147483648
MAX_VIDEO_SIZE=2147483648
